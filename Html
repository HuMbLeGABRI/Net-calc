<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valutatore Incassi Scommesse</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; display: flex; justify-content: center; padding: 20px; }
        .container { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
        h2 { color: #2c3e50; text-align: center; margin-bottom: 20px; }
        .input-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; color: #666; font-weight: bold; }
        input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 16px; }
        .result-box { margin-top: 25px; padding: 15px; background: #e8f5e9; border-left: 5px solid #4caf50; border-radius: 4px; }
        .result-item { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .result-item span:last-child { font-weight: bold; color: #2e7d32; }
        .profit { color: #1b5e20 !important; font-size: 1.2em; }
    </style>
</head>
<body>

<div class="container">
    <h2>Bet Calculator 📊</h2>
    
    <div class="input-group">
        <label for="stake">Importo Scommesso (€)</label>
        <input type="number" id="stake" placeholder="Es. 10" oninput="calculate()">
    </div>

    <div class="input-group">
        <label for="odds">Quota Decimale</label>
        <input type="number" id="odds" step="0.01" placeholder="Es. 1.85" oninput="calculate()">
    </div>

    <div class="result-box">
        <div class="result-item">
            <span>Ritorno Totale:</span>
            <span id="payout">€ 0.00</span>
        </div>
        <div class="result-item">
            <span>Profitto Netto:</span>
            <span id="profit" class="profit">€ 0.00</span>
        </div>
    </div>
</div>

<script>
    function calculate() {
        const stake = parseFloat(document.getElementById('stake').value);
        const odds = parseFloat(document.getElementById('odds').value);
        
        const payoutDisplay = document.getElementById('payout');
        const profitDisplay = document.getElementById('profit');

        if (stake > 0 && odds > 0) {
            // Formula: Ritorno = Importo * Quota
            const payout = stake * odds;
            const profit = payout - stake;

            payoutDisplay.innerText = `€ ${payout.toFixed(2)}`;
            profitDisplay.innerText = `€ ${profit.toFixed(2)}`;
        } else {
            payoutDisplay.innerText = "€ 0.00";
            profitDisplay.innerText = "€ 0.00";
        }
    }
</script>

</body>
</html>
